#!/bin/sh
# Blocks a push of this repo if sitemap.xml is stale relative to the sibling site repos.
cd "$(git rev-parse --show-toplevel)" || exit 0

if ! node generate-sitemap.js --check; then
  echo ""
  echo "Sitemap gate: run 'node generate-sitemap.js', commit sitemap.xml, then push again."
  echo "(Commit changes in the other site repos first, so lastmod dates are current.)"
  exit 1
fi
