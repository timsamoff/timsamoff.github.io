#!/bin/sh
# Sentinel: checks the commit message and strips attribution lines. The logic lives in sentinel-check.js.
cd "$(git rev-parse --show-toplevel)" || exit 1
command -v node >/dev/null 2>&1 || { echo "Sentinel: node was not found, so the commit checks can't run." >&2; exit 1; }
exec node sentinel-check.js --commit-msg "$1"
